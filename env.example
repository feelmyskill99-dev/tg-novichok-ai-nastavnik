# =============================================================================
# AI Наставник — пример .env. Скопируйте в .env и заполните секреты.
# Все секреты держите ВНЕ репозитория. .env уже в .gitignore.
# =============================================================================

# --- Обязательные ключи -------------------------------------------------------
TELEGRAM_TOKEN=
CHANNEL_ID=@your_channel
OWNER_CHAT_ID=
CLAUDE_API_KEY=
OPENAI_API_KEY=
PARTNER_URL=

# --- Админка (этап 1.5) -------------------------------------------------------
# Сильный пароль обязателен. Запрещены: changeme/admin/password/1234/пустое.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# true → bind на 0.0.0.0; по умолчанию 127.0.0.1.
ADMIN_BIND_PUBLIC=false

# --- Режимы публикации --------------------------------------------------------
DRY_RUN=true
GENERATE_IMAGES=true
GENERATE_VIDEO=false
ENABLE_WEBHOOK=false
WEBHOOK_HOST=
WEBHOOK_PORT=8080
WEBHOOK_SECRET=

# --- Расписание / лимиты ------------------------------------------------------
SCHEDULER_TZ=Europe/Moscow
POST_MORNING_HOUR=10
POST_EVENING_HOUR=19
HISTORY_LIMIT=20
IMAGE_EVERY_N=3
PARTNER_EVERY_N=5
QUESTION_EVERY_N=4
FLASH_THRESHOLD=5.0

# --- Claude / OpenAI ----------------------------------------------------------
CLAUDE_MODEL=claude-sonnet-4-6
IMAGE_MODEL=gpt-image-1
IMAGE_MODEL_FALLBACK=gpt-image-1
STYLE_GUIDES_ENABLED=true

# --- News (Stage 6+/12+/14) ---------------------------------------------------
ENABLE_NEWS=true
NEWS_DRY_RUN=true
NEWS_PUBLISH_TO_CHANNEL=false
NEWS_SEND_TO_OWNER=true
# Авто-публикация по impact: 0 = выключено. Поставь, например, 90 чтобы новости
# с item.impact_score>=90 шли сразу в канал без ручного ревью. Лимит
# NEWS_MAX_POSTS_PER_DAY и остальные предохранители продолжают действовать.
NEWS_AUTO_PUBLISH_MIN_IMPACT=0
NEWS_SCAN_INTERVAL_MINUTES=60
NEWS_LOOKBACK_HOURS=24
NEWS_MIN_IMPACT_SCORE=50
NEWS_MAX_POSTS_PER_DAY=3
NEWS_MAX_REVIEWS_PER_DAY=6
NEWS_HUMOR_LEVEL=2
NEWS_SARCASM_LEVEL=1
NEWS_FORMAT_VERSION=v2
NEWS_ALLOW_MEMECOINS=false
NEWS_PRIORITY_AI_CRYPTO=true
NEWS_AUTO_IMAGE=true
NEWS_USE_SOURCE_PREVIEW=true
NEWS_IMAGE_MODE=source_preview_first
NEWS_IMAGE_MIN_IMPACT_SCORE=80
NEWS_IMAGE_FALLBACK_TO_GENERATED=false
NEWS_ALLOW_AUTO_GENERATED_IMAGES=false
NEWS_GENERATE_IMAGE_ONLY_ON_APPROVAL=true
NEWS_SOURCE_IMAGE_SAVE_DIR=news_source_images
NEWS_GENERATED_IMAGE_SAVE_DIR=news_generated_images
CRYPTOPANIC_API_KEY=
COINMARKETCAL_API_KEY=

# --- Author Notes (Stage 10) --------------------------------------------------
ENABLE_AUTHOR_NOTES=true
AUTHOR_NOTE_DRY_RUN=true
AUTHOR_NOTE_REVIEW_REQUIRED=true
AUTHOR_NOTES_PER_WEEK=2

# --- Weekly Diary (Stage 13) --------------------------------------------------
ENABLE_WEEKLY_DIARY=true
WEEKLY_DIARY_DRY_RUN=true

# --- Trading: общие настройки -------------------------------------------------
TRADING_MODE=paper
KILL_SWITCH=false
ALLOW_FUTURES=false
ALLOW_SHORTS=false
DEFAULT_SYMBOL=BTC/USDT
DEFAULT_TIMEFRAME=1h
DEFAULT_MARGIN_MODE=isolated
TREND_TIMEFRAME=4h
TRADE_SETUP_EXPIRES_BARS=12

# --- Trading: риск и плечо ----------------------------------------------------
MAX_LEVERAGE=5
HARD_MAX_LEVERAGE=10
MAX_OPEN_TRADES=2
MAX_RISK_PER_TRADE=0.02
MIN_RISK_REWARD=1.5
MAX_DAILY_LOSS=0.05
MAX_ALLOWED_NOTIONAL_USDT=200
MAX_ENTRY_PRICE_DEVIATION_PCT=0.02
PAPER_EQUITY_USDT=1000

# --- Trading: auto / live -----------------------------------------------------
AUTO_TRADE_ENABLED=false
AUTO_TRADE_SCAN_INTERVAL_MINUTES=15
AUTO_TRADE_TICK_INTERVAL_MINUTES=2
LIVE_TRADING_ENABLED=false
LIVE_WHITELIST=BTC/USDT
LIVE_RECONCILE_INTERVAL_MINUTES=15
CLOSE_POSITIONS_ON_KILL_SWITCH=true
MIN_LIVE_BALANCE_USDT=50
MAX_LIVE_EQUITY_USDT=200
MAX_LIVE_OPEN_POSITIONS=1
MAX_LIVE_RISK_PER_TRADE=0.01
MAX_LIVE_DAILY_LOSS_USDT=5

# --- Trading: confirm-mode (Stage 8a) -----------------------------------------
CONFIRM_TRADING_ENABLED=false
CONFIRM_MODE_PROVEN=false
CONFIRM_TIMEOUT_MINUTES=15
CONFIRM_ORDER_EXPIRES_MINUTES=60
CONFIRM_ENTRY_ORDER_TYPE=limit
REQUIRE_MANUAL_CONFIRMATION=true
READ_REAL_BALANCE=false

# --- Trading: Claude review / публикация --------------------------------------
TRADE_CLAUDE_REVIEW=false
TRADE_REQUIRE_LESSON=false
TRADE_NO_SIGNAL_LANGUAGE=true
TRADE_PUBLISH_MODE=owner_only
TRADE_PUBLISH_WINS=true
TRADE_PUBLISH_LOSSES=true
TRADE_PUBLISH_EXPIRED=false
TRADE_MAX_CHANNEL_POSTS_PER_DAY=2
TRADE_MIN_CHANNEL_IMPACT=0.5
PUBLISH_TRADE_UPDATES_TO_CHANNEL=false

# --- Trading: визуализация (Stage 11) -----------------------------------------
ENABLE_TRADE_VISUALS=true
TRADE_VISUAL_MODE=tv
TRADE_VISUAL_TIMEFRAME=1h
TRADE_VISUAL_BARS=120
PUBLISH_TRADE_VISUALS_TO_CHANNEL=false

# --- Gate.io ключи и скриншоты ------------------------------------------------
GATE_API_KEY=
GATE_API_SECRET=
GATE_API_KEY_RW=
GATE_API_SECRET_RW=
ENABLE_GATE_SCREENSHOTS=false
GATE_SCREENSHOT_MODE=off
ATTACH_GATE_SCREENSHOT_ON_OPEN=false
ATTACH_GATE_SCREENSHOT_ON_CLOSE=false
